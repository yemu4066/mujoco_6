<?xml version="1.0" encoding="utf-8"?>
<!-- L2 对抗专用场景（"申"字形，全部压平到地面层）

  只保留 L2 公共区，L1 整圈删掉。平面布局（北在上）：

              y=+1.5  ┌───────────┐
                      │           │
              y=+0.6　┌────┤   L2   ├────┐
                      │ 西 │  3×3   │ 东 │    ← 东西两翼 1.2×1.2 m
              y=-0.6　└────┤        ├────┘
                      │           │
              y=-1.5  └───────────┘
                     x=-2.7  -1.5  1.5  2.7

  翼尺寸说明：原来 0.7 太小（车 0.6 刚好卡进去），改成 0.8 后 A* 仍然进不去 ——
  inscribed_radius=0.45 要求车中心离墙 0.45，翼内宽 0.7 扣掉两侧 0.9 是负数，
  翼内一个可通行格都没有（nearest_free 会把目标一路吸附回 L2 里）。

  所以取 1.2×1.2：内宽 1.10，可通行带 1.10 − 2×0.45 = 0.20 m，车能进也能转。
  （1.0 是理论临界，实际只剩 1 个栅格能过，太勉强。）

  中央基座：规则里的固定设施 Ø270 × 高 800，位于 (0,0)。
  车起点 (-1.0, 0)，朝东。
  没有动态障碍：mujoco_node 找不到 obstacle_l1/l2 会 warning 后跳过。

  配套地图：maps/l2_arena.yaml（5.50 × 3.10 m，origin [-2.75,-1.55]，res 0.05）
-->
<mujoco model="l2_arena">
  <compiler angle="radian" meshdir="meshes" autolimits="true" balanceinertia="true" />
  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" tolerance="1e-12" />

  <asset>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 8" dir="0 0 -1" directional="true" castshadow="true"
           diffuse="0.55 0.55 0.55" specular="0.15 0.15 0.15" />
    <camera name="camera_top"   pos="0.00 0.00 7.50" quat="1 0 0 0" fovy="50" />
    <camera name="camera_sw"    pos="-4.20 -4.20 3.60" xyaxes="0.707107 -0.707107 0.000000 0.324132 0.324132 0.888750" fovy="45" />
    <camera name="camera_south" pos="0.00 -5.40 2.00" xyaxes="1.000000 -0.000000 0.000000 0.000000 0.263976 0.964529" fovy="45" />

    <geom name="floor" type="plane" size="10 10 0.1"
          rgba="0.55 0.55 0.58 1" contype="0" conaffinity="0" condim="3" />
    <geom name="floor_collision" type="plane" size="10 10 0.1"
          rgba="0 0 0 0" contype="1" conaffinity="1" condim="3"
          friction="1.0 0.005 0.0001" />

    <!-- ===== "申"字轮廓墙 ===== -->
    <geom name="墙-北" type="box" size="1.5 0.025 0.25" pos="0 1.5 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-南" type="box" size="1.5 0.025 0.25" pos="0 -1.5 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-东-北" type="box" size="0.025 0.45 0.25" pos="1.5 1.05 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-东-南" type="box" size="0.025 0.45 0.25" pos="1.5 -1.05 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-西-北" type="box" size="0.025 0.45 0.25" pos="-1.5 1.05 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-西-南" type="box" size="0.025 0.45 0.25" pos="-1.5 -1.05 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-东翼-北" type="box" size="0.6000000000000001 0.025 0.25" pos="2.1 0.6 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-东翼-南" type="box" size="0.6000000000000001 0.025 0.25" pos="2.1 -0.6 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-东翼-端" type="box" size="0.025 0.6 0.25" pos="2.7 0 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-西翼-北" type="box" size="0.6000000000000001 0.025 0.25" pos="-2.1 0.6 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-西翼-南" type="box" size="0.6000000000000001 0.025 0.25" pos="-2.1 -0.6 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
    <geom name="墙-西翼-端" type="box" size="0.025 0.6 0.25" pos="-2.7 0 0.25"
          rgba="0.35 0.35 0.40 1" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>

    <geom name="center_base" type="cylinder" size="0.135 0.4" pos="0 0 0.4"
          rgba="0.75 0.70 0.20 1" contype="1" conaffinity="1" condim="3"
          friction="1.0 0.005 0.0001" />

    <body name="chassis" pos="-1.0 0 0.235" quat="1 0 0 0">
        <freejoint name="root"/>

        <geom name="chassis_visual_main" type="box" size="0.300 0.300 0.08" pos="0 0 -0.0" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/>
        <!-- <geom name="chassis_visual_top" type="box" size="0.38 0.38 0.01" pos="0 0 0.06" rgba="0.6 0.2 0.2 1" contype="0" conaffinity="0" mass="0"/> -->

        <!-- <geom name="chassis_visual_center" type="box" size="0.4 0.4 0.04" pos="-0.02 0 0" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/> -->
        <!-- <geom name="chassis_visual_rear" type="box" size="0.16 0.14 0.03" pos="-0.18 0 0.04" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/> -->
        <geom name="chassis_mass" type="box" size="0.30 0.20 0.04" pos="0.10 0.03 -0.05" rgba="0.8 0.3 0.3 0" mass="16" contype="0" conaffinity="0"/>
        <!-- 与 650 视觉方块一致的碰撞体：参与物理碰撞，解决“车身穿墙” -->
        <geom name="chassis_collision" type="box" size="0.300 0.300 0.08" pos="0 0 -0.02"
              rgba="0 0 0 0" mass="0" contype="1" conaffinity="1" group="1"
              solref="0.02 1" solimp="0.9 0.95 0.001"/>
        <body name="wheel0_pivot" pos="0.24 0.24 -0.093">
            <joint name="wheel0_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel0" pos="0 0 -0.058">
                <joint name="wheel0_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel1_pivot" pos="0.24 -0.24 -0.093">
            <joint name="wheel1_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel1" pos="0 0 -0.058">
                <joint name="wheel1_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel2_pivot" pos="-0.24 0.24 -0.093">
            <joint name="wheel2_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel2" pos="0 0 -0.058">
                <joint name="wheel2_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel3_pivot" pos="-0.24 -0.24 -0.093">
            <joint name="wheel3_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel3" pos="0 0 -0.058">
                <joint name="wheel3_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <geom name="head_marker" type="box" size="0.05 0.2 0.01" pos="0.27 0 0.085" rgba="0 1 0 1" contype="0" conaffinity="0" mass="0"/>
    </body>
    <!-- ===== 对方小车（mocap，仅视觉 + 真值发布，不参与物理碰撞）=====
         0.65 × 0.65 方块，起点在东翼中心 (2.1, 0)。
         运动由 mujoco_node 的 obstacle_motion_mode='l2_corners' 驱动：
         东翼等 10 s → 匀速走到随机一个 L2 角（(±1.0, ±1.0)，不贴墙）→
         停 3 s → 匀速走回东翼 → 循环。速度 0.6 m/s。 -->
    <body name="obstacle_l1" mocap="true" pos="2.1 0 0.25">
      <geom name="obstacle_l1_geom" type="box" size="0.325 0.325 0.25"
            mass="5.0" rgba="1 0.20 0.20 0.85" contype="0" conaffinity="0" group="2" />
    </body>

  </worldbody>

  <contact>
    <exclude body1="chassis" body2="wheel0_pivot"/>
    <exclude body1="chassis" body2="wheel1_pivot"/>
    <exclude body1="chassis" body2="wheel2_pivot"/>
    <exclude body1="chassis" body2="wheel3_pivot"/>
    <exclude body1="chassis" body2="wheel0"/>
    <exclude body1="chassis" body2="wheel1"/>
    <exclude body1="chassis" body2="wheel2"/>
    <exclude body1="chassis" body2="wheel3"/>
  </contact>

  <actuator>
    <position joint="wheel0_steer" name="steer0" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel0_drive" name="drive0" kv="40" forcerange="-180 180"/>
    <position joint="wheel1_steer" name="steer1" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel1_drive" name="drive1" kv="40" forcerange="-180 180"/>
    <position joint="wheel2_steer" name="steer2" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel2_drive" name="drive2" kv="40" forcerange="-180 180"/>
    <position joint="wheel3_steer" name="steer3" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel3_drive" name="drive3" kv="40" forcerange="-180 180"/>
  </actuator>
</mujoco>
