<?xml version="1.0" encoding="utf-8"?>
<!-- rc2027 场地 —— 按 V3 规则（2026-11 新版开源场地）重建

  与旧版 scene_nav_v1_old.xml 的差异（新版把场地整体转了 90°）：
    · 中央隔板沿 x 轴（y=0），把地面分成南北两半（旧版是东西，沿 y 轴）
    · 过渡带在南北两侧 y∈[3,4] 和 [-4,-3]（旧版在东西 x∈[±3,±4]）
    · 每条过渡带：西侧 4 级台阶（每级 150 mm 高、1 m 深），
      东侧 9.68° 坡道（沿 x 长 3.5 m、宽 1 m、升 0.597 m）
    · L1 北/南围栏在 x∈[-1.8,-0.8] 留 1 m 宽的台阶口
    · 五色石基座在 (4.15, 0)（旧版在 (0, 4.25)）
    · L2 四周只有 4 mm 的视觉边界线，不是物理墙
    · 中央基座 Ø270 × 高 800，坐在 L2 顶面

  几何全部用 primitive（box/cylinder），只有坡道用 meshes/ramp.obj ——
  新版开源 SDF 本来就是这么做的，比旧版几十个 mesh 轻得多、好维护。

  保留了本项目自己的：主分支舵轮底盘 chassis（起点在东南角地面），
  以及 obstacle_l1 / obstacle_l2 两个 mocap 移动对手（动态避障测试用）。

  来源：r2027_gazebo_model_copy（深圳职业技术大学 Techx 战队，
        基于南华大学衡山丌战队 gazebo_models 修改）
-->
<mujoco model="rc2027_nav">
  <compiler angle="radian" meshdir="meshes" autolimits="true" balanceinertia="true" />
  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" tolerance="1e-12" />

  <asset>
    <mesh name="mesh_ramp" file="ramp.obj" />
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 12" dir="0 0 -1" directional="true" castshadow="true"
           diffuse="0.55 0.55 0.55" specular="0.15 0.15 0.15" />
    <camera name="camera_top"   pos="0.00 0.00 13.00" quat="1 0 0 0" fovy="50" />
    <camera name="camera_sw"    pos="-8.50 -8.50 6.50" xyaxes="0.707107 -0.707107 0.000000 0.324132 0.324132 0.888750" fovy="45" />
    <camera name="camera_south" pos="0.00 -9.50 3.20" xyaxes="1.000000 -0.000000 0.000000 0.000000 0.263976 0.964529" fovy="45" />

    <!-- ===== 地面 11×11（碰撞一层 + 红蓝两色视觉）===== -->
    <geom name="col_ground" type="box" size="5.5 5.5 0.01" pos="0 0 -0.01"
          rgba="1 1 1 0" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="地面区-红" type="box" size="5.5 2.75 0.005" pos="0 2.75 0.005"
          rgba="0.94 0.82 0.82 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="地面区-蓝" type="box" size="5.5 2.75 0.005" pos="0 -2.75 0.005"
          rgba="0.67 0.82 0.90 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>

    <!-- ===== 中央隔板：把地面分成南北两半（规则 V3）===== -->
    <geom name="中央隔板_1" type="box" size="0.325 0.05 0.04" pos="-5.175 0 0.04"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="中央隔板_2" type="box" size="1.8 0.0305 0.04" pos="-1.84 0.015 0.04"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="中央隔板_3" type="box" size="1.825 0.0405 0.04" pos="1.825 0.01 0.04"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="中央隔板_4" type="box" size="0.45 0.025 0.04" pos="5.125 0.015 0.04"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>

    <!-- ===== 外围墙（内高 80 mm，厚 50 mm）===== -->
    <geom name="外墙-东" type="box" size="0.025 5.5 0.04" pos="5.55 0 0.04"
          rgba="0.60 0.45 0.35 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="外墙-西" type="box" size="0.025 5.5 0.04" pos="-5.55 0 0.04"
          rgba="0.60 0.45 0.35 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="外墙-北" type="box" size="5.5 0.025 0.04" pos="0 5.55 0.04"
          rgba="0.60 0.45 0.35 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="外墙-南" type="box" size="5.5 0.025 0.04" pos="0 -5.55 0.04"
          rgba="0.60 0.45 0.35 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>

    <!-- ===== L1 台体 6×6，顶面 z=0.6 ===== -->
    <geom name="L1" type="box" size="3 3 0.3" pos="0 0 0.3"
          rgba="0.80 0.80 0.82 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1隔板-左" type="box" size="0.925 0.025 0.025" pos="-1.3255 0 0.625"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1隔板-右" type="box" size="1.125 0.025 0.025" pos="1.125 0 0.625"
          rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-西" type="box" size="0.025 3 0.025" pos="-3 0 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-东" type="box" size="0.025 3 0.025" pos="3 0 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-北-东" type="box" size="1.9 0.025 0.025" pos="1.1 3 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-北-西" type="box" size="0.6 0.025 0.025" pos="-2.4 3 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-南-东" type="box" size="1.9 0.025 0.025" pos="1.1 -3 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L1围栏-南-西" type="box" size="0.6 0.025 0.025" pos="-2.4 -3 0.625"
          rgba="0.70 0.70 0.72 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>

    <!-- ===== 北过渡带 y∈[3,4]：西侧 4 级台阶 + 东侧 9.68° 坡道 ===== -->
    <geom name="北台阶-2" type="box" size="0.95 0.5 0.075" pos="-1.75 3.5 0.075"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="北台阶-3" type="box" size="0.8 0.5 0.075" pos="-1.6 3.5 0.225"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="北台阶-4" type="box" size="0.65 0.5 0.075" pos="-1.45 3.5 0.375"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="北台阶-5" type="box" size="0.5 0.5 0.075" pos="-1.3 3.5 0.525"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="北坡道" type="mesh" mesh="mesh_ramp" pos="0 3 0"
          rgba="0.72 0.66 0.55 1" contype="1" conaffinity="1" condim="3"
          friction="0.9 0.005 0.0001"/>

    <!-- ===== 南过渡带 y∈[-4,-3]（镜像）===== -->
    <geom name="南台阶-2" type="box" size="0.95 0.5 0.075" pos="-1.75 -3.5 0.075"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="南台阶-3" type="box" size="0.8 0.5 0.075" pos="-1.6 -3.5 0.225"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="南台阶-4" type="box" size="0.65 0.5 0.075" pos="-1.45 -3.5 0.375"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="南台阶-5" type="box" size="0.5 0.5 0.075" pos="-1.3 -3.5 0.525"
          rgba="0.78 0.72 0.60 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="南坡道" type="mesh" mesh="mesh_ramp" pos="0 -4 0"
          rgba="0.72 0.66 0.55 1" contype="1" conaffinity="1" condim="3"
          friction="0.9 0.005 0.0001"/>

    <!-- ===== L2 台体 3×3，顶面 z=0.9 ===== -->
    <geom name="L2" type="box" size="1.5 1.5 0.15" pos="0 0 0.75"
          rgba="0.86 0.86 0.88 1" contype="1" conaffinity="1" condim="3" friction="0.9 0.005 0.0001"/>
    <!-- L2 四周边界线（原 SDF 只有 4 mm 厚，纯视觉，不挡车）-->
    <geom name="L2界线-北" type="box" size="1.504 0.02 0.15" pos="0 1.502 0.75"
          rgba="0.35 0.35 0.38 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L2界线-南" type="box" size="1.504 0.02 0.15" pos="0 -1.502 0.75"
          rgba="0.35 0.35 0.38 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L2界线-东" type="box" size="0.02 1.504 0.15" pos="1.502 0 0.75"
          rgba="0.35 0.35 0.38 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>
    <geom name="L2界线-西" type="box" size="0.02 1.504 0.15" pos="-1.502 0 0.75"
          rgba="0.35 0.35 0.38 1" contype="0" conaffinity="0" condim="3" friction="0.9 0.005 0.0001"/>

    <!-- ===== 基座 ===== -->
    <geom name="中央基座" type="cylinder" size="0.135 0.4" pos="0 0 1.3"
          rgba="0.75 0.70 0.20 1" contype="1" conaffinity="1" condim="3"
          friction="0.9 0.005 0.0001"/>
    <geom name="五色石基座" type="cylinder" size="0.135 0.25" pos="4.15 0 0.25"
          rgba="0.75 0.70 0.20 1" contype="1" conaffinity="1" condim="3"
          friction="0.9 0.005 0.0001"/>

    <!-- ===== 两个 650×650 移动对手（mocap，视觉 + 真值发布，不参与物理碰撞）=====
         L1 在台面上 z=0.625+0.25=0.875；L2 在台面上 z=0.925+0.25=1.175 -->
    <body name="obstacle_l1" mocap="true" pos="-2.2 -2.5 0.875">
      <geom name="obstacle_l1_geom" type="box" size="0.325 0.325 0.25"
            mass="5.0" rgba="1 0.55 0.10 0.85" contype="0" conaffinity="0" group="2" />
    </body>
    <body name="obstacle_l2" mocap="true" pos="0.85 0 1.175">
      <geom name="obstacle_l2_geom" type="box" size="0.325 0.325 0.25"
            mass="5.0" rgba="1 0.20 0.60 0.85" contype="0" conaffinity="0" group="2" />
    </body>

    <body name="chassis" pos="4.75 -4.80 0.235" quat="0.7071067811865476 0 0 0.7071067811865476">
        <freejoint name="root"/>

        <geom name="chassis_visual_main" type="box" size="0.300 0.300 0.08" pos="0 0 -0.0" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/>
        <!-- <geom name="chassis_visual_top" type="box" size="0.38 0.38 0.01" pos="0 0 0.06" rgba="0.6 0.2 0.2 1" contype="0" conaffinity="0" mass="0"/> -->

        <!-- <geom name="chassis_visual_center" type="box" size="0.4 0.4 0.04" pos="-0.02 0 0" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/> -->
        <!-- <geom name="chassis_visual_rear" type="box" size="0.16 0.14 0.03" pos="-0.18 0 0.04" rgba="0.8 0.3 0.3 1" contype="0" conaffinity="0" mass="0"/> -->
        <geom name="chassis_mass" type="box" size="0.30 0.20 0.04" pos="0.10 0.03 -0.05" rgba="0.8 0.3 0.3 0" mass="16" contype="0" conaffinity="0"/>
        <!-- 与 650 视觉方块一致的碰撞体：参与物理碰撞，解决“车身穿墙” -->
        <geom name="chassis_collision" type="box" size="0.300 0.300 0.08" pos="0 0 -0.02"
              rgba="0 0 0 0" mass="0" contype="1" conaffinity="1" group="1"
              solref="0.02 1" solimp="0.9 0.95 0.001"/>
        <body name="wheel0_pivot" pos="0.24 0.24 -0.093">
            <joint name="wheel0_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel0" pos="0 0 -0.058">
                <joint name="wheel0_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel1_pivot" pos="0.24 -0.24 -0.093">
            <joint name="wheel1_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel1" pos="0 0 -0.058">
                <joint name="wheel1_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel2_pivot" pos="-0.24 0.24 -0.093">
            <joint name="wheel2_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel2" pos="0 0 -0.058">
                <joint name="wheel2_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <body name="wheel3_pivot" pos="-0.24 -0.24 -0.093">
            <joint name="wheel3_steer" type="hinge" axis="0 0 1" damping="2.0" armature="0.01"/>
            <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.8 1" mass="0.5" contype="0" conaffinity="0"/>
            <body name="wheel3" pos="0 0 -0.058">
                <joint name="wheel3_drive" type="hinge" axis="0 1 0" damping="2.0" armature="0.05"/>
                <geom type="cylinder" size="0.058 0.02" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" friction="2.5 0.01 0.005" mass="1.0" contype="1" conaffinity="1"/>
            </body>
        </body>

        <geom name="head_marker" type="box" size="0.05 0.2 0.01" pos="0.27 0 0.085" rgba="0 1 0 1" contype="0" conaffinity="0" mass="0"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="chassis" body2="wheel0_pivot"/>
    <exclude body1="chassis" body2="wheel1_pivot"/>
    <exclude body1="chassis" body2="wheel2_pivot"/>
    <exclude body1="chassis" body2="wheel3_pivot"/>
    <exclude body1="chassis" body2="wheel0"/>
    <exclude body1="chassis" body2="wheel1"/>
    <exclude body1="chassis" body2="wheel2"/>
    <exclude body1="chassis" body2="wheel3"/>
  </contact>

  <actuator>
    <position joint="wheel0_steer" name="steer0" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel0_drive" name="drive0" kv="40" forcerange="-180 180"/>
    <position joint="wheel1_steer" name="steer1" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel1_drive" name="drive1" kv="40" forcerange="-180 180"/>
    <position joint="wheel2_steer" name="steer2" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel2_drive" name="drive2" kv="40" forcerange="-180 180"/>
    <position joint="wheel3_steer" name="steer3" kp="50" forcerange="-300 300"/>
    <velocity joint="wheel3_drive" name="drive3" kv="40" forcerange="-180 180"/>
  </actuator>
</mujoco>
