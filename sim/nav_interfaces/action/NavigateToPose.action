# 导航 задача：主逻辑唯一需要调用的接口。
#
# 语义：把机器人开到 target 位姿并停稳。
#   - 成功 = 距离误差 < arrive_xy_tol 且朝向误差 < arrive_yaw_tol 且已停稳
#   - 失败 = 超时 / 无解 / 被判卡住 / 被取消
#
# 坐标系：target 的 frame_id 必须是 "map"（若为空也按 map 处理）。
# 单位：位置 m，角度 rad，速度 m/s。

# ============================ Goal ============================
geometry_msgs/PoseStamped target   # 目标位姿；position.z 忽略，orientation 只取 yaw

float32 max_speed                  # 本次任务速度上限 [m/s]；<=0 表示用节点默认值
bool    precise                    # true=终点朝向也要摆正（取放料用）
                                   # false=到达位置即可（赶路用），可省 1~2 s

float32 timeout                    # 本任务超时 [s]；<=0 表示用节点默认值

---

# =========================== Result ===========================
bool   success                     # 是否"到达并停稳"
uint8  code                        # 见下方常量，便于主逻辑分支判断
string message                     # 人读的原因，写日志用

# 结束时的实际位姿（调试用：主逻辑可比对自己记录的期望值）
geometry_msgs/PoseStamped final_pose
float32 elapsed                    # 实际耗时 [s]

# code 取值约定（改这里必须同步改文档 + nav_server/navigate_server.py）
uint8 CODE_ARRIVED     = 0         # 成功到达
uint8 CODE_TIMEOUT     = 1         # 超时未到达
uint8 CODE_NO_PATH     = 2         # 起点/终点不可达，或 A* 无解
uint8 CODE_CANCELED    = 3         # 被调用方取消
uint8 CODE_STUCK       = 4         # 位移长时间不变，判定卡住
uint8 CODE_ABORTED     = 5         # 内部错误 / 上游断流
uint8 CODE_REJECTED    = 6         # 目标被拒（越界、在障碍里）

---

# ========================== Feedback ==========================
geometry_msgs/PoseStamped current_pose   # 当前位姿（map 系）

float32 distance_remaining         # 到目标剩余直线距离 [m]
float32 yaw_error                  # 朝向剩余误差 [rad]，已归一化到 [-pi, pi]
float32 eta                        # 粗估剩余时间 [s]

string  phase                      # 当前阶段，主逻辑可据此做提示/降速
                                   # IDLE | ALIGN | RAMP_UP | TRACK | ARRIVED

float32 speed                      # 当前合成速度 [m/s]，用于判断是否停稳
