{
  "name": "mujoco_6",
  "dockerComposeFile": "docker-compose.yml",
  "service": "nav-service",
  "workspaceFolder": "/home/Elaina/ros2_ws",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python3",
        "python.analysis.extraPaths": [
          "/home/Elaina/ros2_ws"
        ],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends libglx-mesa0 libegl1 libgbm1 libgl1 && echo '[mujoco_6] Mesa 就绪'"
}
